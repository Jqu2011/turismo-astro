---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { sitio } from '../data/sitio.js';
import '../styles/global.css';
const { title, description = sitio.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | {sitio.name}</title><meta name="description" content={description}/><meta property="og:title" content={`${title} | ${sitio.name}`}/><meta property="og:description" content={description}/>{canonical && <link rel="canonical" href={canonical}/>}</head><body><Header/><main class="wrap"><slot/><WhatsApp/></main><Footer/></body></html>
