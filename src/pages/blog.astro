---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { sitio, url } from '../data/sitio.js';
---
<Layout title="Blog" description={`Artículos y consejos de ${sitio.name}.`}><h1>Nuestro blog</h1><p class="lead">Ideas y consejos prácticos para aprender algo nuevo.</p><div class="cards">{sitio.posts.map(post => <Card {...post} href={url('blog/' + post.slug + '/')}/>)}</div></Layout>
