---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { sitio, url } from '../data/sitio.js';
---
<Layout title="Inicio" description={sitio.description}><section class="hero"><div><span class="eyebrow">BIENVENIDOS</span><h1>{sitio.hero}</h1><p>{sitio.description}</p><a class="button" href={url('servicios/')}>Ver {sitio.section.toLowerCase()}</a></div><img src={url('images/portada.svg')} alt={sitio.name}/></section><h2>Últimos artículos</h2><div class="cards">{sitio.posts.map(post => <Card {...post} href={url('blog/' + post.slug + '/')}/>)}</div></Layout>
