---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { sitio } from '../data/sitio.js';
---
<Layout title={sitio.section} description={`Conoce nuestra oferta de ${sitio.section.toLowerCase()}.`}><h1>{sitio.section}</h1><p class="lead">Descubre tres ciudades y encuentra inspiración para tu próxima escapada.</p><div class="cards">{sitio.items.map(item => <Card {...item}/>)}</div></Layout>
